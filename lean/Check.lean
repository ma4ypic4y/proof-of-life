import MirrorLife

/-! Sanity checks (not part of the proof).
  1. Cross-check the Lean interpreter against analysis/bff.py on the vectors in
     test_vectors.txt (generated by gen_vectors.py).
  2. Print the axioms the main theorem depends on. -/

open MirrorLife

def hexVal (c : Char) : Nat :=
  if '0' ≤ c ∧ c ≤ '9' then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10

def parseHex : List Char → List Nat
  | a :: b :: rest => (hexVal a * 16 + hexVal b) :: parseHex rest
  | _ => []

def mkTape (l : List Nat) : Tape := Vector.ofFn fun i => (l.getD i.val 0).toUInt8

def checkLine (line : String) : Bool :=
  let bytes := parseHex line.toList
  ((run (mkTape (bytes.take 128))).toList.map (·.toNat)) == bytes.drop 128

def crossCheck : IO Unit := do
  let s ← IO.FS.readFile "test_vectors.txt"
  let lines := (s.splitOn "\n").filter (· ≠ "")
  let ok := lines.filter checkLine
  IO.println s!"{ok.length} / {lines.length} tapes match bff.py"

#eval crossCheck

#print axioms aexec_sound
#print axioms abstract_run
#print axioms mirror_copy
