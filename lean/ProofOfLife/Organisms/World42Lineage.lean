/-- The mirror strand of world-42 copies back into world-42, for every partner. -/
theorem lineage : ∀ B : Vector UInt8 64, run (P.reverse ++ B) = P.reverse ++ P := by
  intro B
  have h := rev_mirror B
  rw [Q_eq, Vector.reverse_reverse] at h
  exact h

/-- Both strands copy each other for any partner. -/
theorem lineage_closed : (∀ B : Vector UInt8 64, run (P ++ B) = P ++ P.reverse) ∧
    (∀ B : Vector UInt8 64, run (P.reverse ++ B) = P.reverse ++ P) :=
  ⟨mirror, lineage⟩

