/-- The mirror strand of world-30 copies back into world-30, for every partner. -/
theorem lineage : ∀ B : Vector UInt8 64, run (P.reverse ++ B) = P.reverse ++ P := by
  intro B
  have h := rev_mirror B
  rw [Q_eq, Vector.reverse_reverse] at h
  exact h

