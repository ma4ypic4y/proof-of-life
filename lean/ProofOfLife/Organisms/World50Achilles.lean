theorem achB_shape : ∀ j (h : j < 64), achB[j] = if j = 63 then ACell.nz else ACell.unk := by
  decide +kernel

theorem partnerOK_achB (B : Vector UInt8 64) (hB : B[63] ≠ 0) : PartnerOK B achB := by
  intro j h
  rw [achB_shape j h]
  by_cases hj : j = 63
  · subst hj; simp only [if_true, CellAgrees]; exact hB
  · simp only [hj, if_false, CellAgrees]

/-- **Achilles.** world-50 mirror-copies itself into every partner whose last byte
(tape cell 127, tested by its loop before it is overwritten) is nonzero. -/
theorem achilles : ∀ B : Vector UInt8 64, B[63] ≠ 0 → run (P ++ B) = P ++ P.reverse :=
  fun B hB => guarded_mirror run_ok final_ok B (partnerOK_achB B hB)

